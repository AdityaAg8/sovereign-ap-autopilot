# Review UI environment. Copy to .env.local for `pnpm dev`; every NEXT_PUBLIC_*
# value is baked in at build time, so changing one for a production build means rebuilding.

# Which ApiClient adapter src/lib/api/client.ts hands the app: "fixture" (default, in-memory
# dev/demo data, no backend needed) or "http" (the real apx/api service).
# NEXT_PUBLIC_API_MODE=fixture

# Base URL of apx/api when NEXT_PUBLIC_API_MODE=http. Defaults to http://localhost:8000
# (uvicorn's default) when unset.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
