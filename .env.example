# Local secrets template (PRD §10 M0.2). Copy to `.env` (gitignored) and fill in real
# values; `.env` is never read by this assistant and never committed.

# Required: Hugging Face access token used by scripts/resolve_models.py (PRD §10 M0.4)
# to resolve and download gated/local model weights. Get one at
# https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# Optional: DocILE dataset access token (PRD §1, §10 M1.1). Without it the DocILE
# fetcher is skipped and evaluation degrades gracefully to the other datasets.
DOCILE_TOKEN=

# Local `postgres` service (infra/compose.yaml, PRD §10 M0.4). Only reachable from the `app`
# network; host dev tools (psql, a DB GUI, `make eval-attacks`) need the opt-in `devports`
# profile (`COMPOSE_PROFILES=devports make up`, 127.0.0.1:5432). User and database default to
# `apx`. POSTGRES_PASSWORD has no default: `make env`/`make up` generate it, and compose refuses
# to start without it. An install whose volume predates this: `make rotate-db-password`.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Password of the read-only `apx_agent_ro` role the assistant queries through (migration 0013,
# apx/agent/sql.py). Generated by `make env`; use A-Z a-z 0-9 - _ only (16+ characters).
AGENT_RO_PASSWORD=
# Shared bearer token between the parse service and its clients (REVIEW N-06); `make env` generates it.
PARSE_SERVICE_TOKEN=

# REST API (apx/api, M5.3). API_JWT_SECRET is required (>= 32 chars); `make bootstrap`/`make up`
# generate it (scripts/init_env.py). The rest have safe defaults.
API_JWT_SECRET=
# API_JWT_ALGORITHM=HS256
# API_ACCESS_TOKEN_MINUTES=15
# API_CORS_ORIGIN=http://localhost:3000
# API_LOGIN_BURST=5
# API_LOGIN_REFILL_PER_MINUTE=5
# APPROVAL_LIMIT (no prefix) is the one P3 limit the API and the worker both read (AED). The old
# API_APPROVAL_LIMIT / WORKER_APPROVAL_LIMIT are refused at start-up unless they equal it.
# APPROVAL_LIMIT=10000.00
# API_SOD_COOLDOWN_DAYS=30
# API_TEMPORAL_ADDRESS=localhost:7233

# Ingest: data/inbox/ watcher + shared upload path (apx/ingest, M5.5). All optional; the size and
# page limits default to PRD §10 M5.3's 20 MB / 30 pages.
# INGEST_INBOX_DIR=data/inbox
# INGEST_STORE_DIR=data/documents
# INGEST_MAX_BYTES=20971520
# INGEST_MAX_PAGES=30

# Worker buyer identity (ADR-0012 amendment 2): our own organisation, written as the PINT AE
# buyer. WORKER_BUYER_TRN is required outside compose (the worker refuses to start without a
# valid 15-digit TRN); compose defaults all three to the demo company used by factory/.
# WORKER_BUYER_TRN=100234567800003
# WORKER_BUYER_TRADE_LICENSE=1045821
# WORKER_BUYER_ADDRESS=Warehouse 12, Al Quoz Industrial Area 3, Dubai, United Arab Emirates, P.O. Box 45210
