{% import "_shared.html.j2" as s %}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
{{ s.head_common() }}
{% include "_css_ledger_classic.html.j2" %}
</head>
<body>
<div class="sheet">
  <header class="letterhead">
    <div>
      <div class="supplier-name">{{ s.field('supplier_name', supplier_name_en) }}</div>
      <div class="supplier-sub">{{ s.field_ltr('supplier_address', supplier_address_en) }}</div>
      <div class="supplier-sub">TRN {{ s.field_ltr('supplier_trn', supplier_trn) }}</div>
    </div>
    <div class="invoice-meta">
      <div class="doc-title">TAX INVOICE</div>
      <div class="ledger-tab">No. {{ s.field_ltr('invoice_number', invoice_number) }}</div>
      <table class="meta">
        <tr><th>Issue date</th><td>{{ s.field_ltr('issue_date', issue_date_display) }}</td></tr>
        <tr><th>Due date</th><td>{{ s.field_ltr('due_date', due_date_display) }}</td></tr>
        <tr><th>PO number</th><td>{{ s.field_ltr('po_number', po_number) }}</td></tr>
        <tr><th>Currency</th><td>{{ s.field_ltr('currency', currency) }}</td></tr>
      </table>
    </div>
  </header>

  <section class="parties">
    <div>
      <div class="party-label">Bill to</div>
      <div class="party-name">{{ s.field('buyer_name', buyer_name_en) }}</div>
      <div class="party-line">{{ buyer_address_en }}</div>
      <div class="party-line">TRN {{ s.field_ltr('buyer_trn', buyer_trn) }}</div>
    </div>
    <div class="tax-case-note">
      <div class="tax-case-label">{{ tax_case_label_en }}</div>
      <p>{{ tax_case_note_en }}</p>
    </div>
  </section>

  <table class="items">
    <thead>
      <tr>
        <th>#</th><th>Description</th><th class="num">Qty</th>
        <th class="num">Unit price</th><th class="num">VAT</th><th class="num">Net amount</th>
      </tr>
    </thead>
    <tbody>
    {% for line in lines %}
      <tr class="ap-row">
        <td>{{ line.index }}</td>
        <td>{{ s.field('description', line.description_en) }}</td>
        <td class="num">{{ s.field_ltr('quantity', line.quantity | qty) }}</td>
        <td class="num">{{ s.field_ltr('unit_price', line.unit_price | money) }}</td>
        <td class="num">{{ s.field_ltr('vat_rate', line.vat_rate | pct) }}</td>
        <td class="num">{{ s.field_ltr('net_amount', line.net_amount | money) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <section class="totals">
    <table>
      <tr><th>Subtotal</th><td>{{ s.field_ltr('subtotal', subtotal | money) }} {{ currency }}</td></tr>
      <tr><th>VAT total</th><td>{{ s.field_ltr('vat_total', vat_total | money) }} {{ currency }}</td></tr>
      <tr class="grand"><th>Total due</th><td>{{ s.field_ltr('total', total | money) }} {{ currency }}</td></tr>
    </table>
  </section>

  <footer>
    Payment by bank transfer only, to IBAN {{ s.field_ltr('iban', iban) }}. This invoice was
    generated by the Sovereign AP Autopilot synthetic document factory.
  </footer>
</div>
</body>
</html>
