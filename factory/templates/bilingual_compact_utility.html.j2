{% import "_shared.html.j2" as s %}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
{{ s.head_common() }}
{% include "_css_compact_utility.html.j2" %}
<style>
th.ar-col, td.ar-col { direction: rtl; text-align: start; }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div>
      <div class="doc-title">Tax invoice / <span class="ar" dir="rtl">فاتورة ضريبية</span></div>
      <div class="supplier-name">{{ s.field('supplier_name', supplier_name_en) }}</div>
      <div class="supplier-name ar" dir="rtl" lang="ar">{{ s.field('supplier_name', supplier_name_ar) }}</div>
      <div class="supplier-sub">{{ s.field_ltr('supplier_address', supplier_address_en) }}</div>
      <div class="supplier-sub">TRN {{ s.field_ltr('supplier_trn', supplier_trn) }}</div>
    </div>
    <div class="invoice-meta">
      <table class="meta">
        <tr><th>No. / رقم</th><td>{{ s.field_ltr('invoice_number', invoice_number) }}</td></tr>
        <tr><th>Issue / إصدار</th><td>{{ s.field_ltr('issue_date', issue_date_display) }}</td></tr>
        <tr><th>Due / استحقاق</th><td>{{ s.field_ltr('due_date', due_date_display) }}</td></tr>
        <tr><th>PO / أمر شراء</th><td>{{ s.field_ltr('po_number', po_number) }}</td></tr>
        <tr><th>Currency / عملة</th><td>{{ s.field_ltr('currency', currency) }}</td></tr>
      </table>
    </div>
  </header>

  <section class="parties">
    <div>
      <div class="party-label">Bill to / <span class="ar" dir="rtl">إلى</span></div>
      <div class="party-name">{{ s.field('buyer_name', buyer_name_en) }}</div>
      <div class="party-name ar" dir="rtl" lang="ar">{{ s.field('buyer_name', buyer_name_ar) }}</div>
      <div class="party-line">{{ buyer_address_en }} &middot; TRN {{ s.field_ltr('buyer_trn', buyer_trn) }}</div>
    </div>
    <div class="tax-case-note">
      <span class="tax-case-label">{{ tax_case_label_en }}.</span> {{ tax_case_note_en }}
      <br><span dir="rtl" lang="ar"><span class="tax-case-label">{{ tax_case_label_ar }}.</span> {{ tax_case_note_ar }}</span>
    </div>
  </section>

  <table class="items">
    <thead>
      <tr>
        <th class="idx">#</th>
        <th>Description</th>
        <th class="ar-col">البيان</th>
        <th class="num">Qty</th><th class="num">Unit price</th><th class="num">VAT</th><th class="num">Net amount</th>
      </tr>
    </thead>
    <tbody>
    {% for line in lines %}
      <tr class="ap-row">
        <td class="idx">{{ line.index }}</td>
        <td>{{ s.field('description', line.description_en) }}</td>
        <td class="ar-col" lang="ar">{{ s.field('description', line.description_ar) }}</td>
        <td class="num">{{ s.field_ltr('quantity', line.quantity | qty) }}</td>
        <td class="num">{{ s.field_ltr('unit_price', line.unit_price | money) }}</td>
        <td class="num">{{ s.field_ltr('vat_rate', line.vat_rate | pct) }}</td>
        <td class="num">{{ s.field_ltr('net_amount', line.net_amount | money) }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <section class="totals">
    <table>
      <tr><th>Subtotal / إجمالي</th><td>{{ s.field_ltr('subtotal', subtotal | money) }} {{ currency }}</td></tr>
      <tr><th>VAT / ضريبة</th><td>{{ s.field_ltr('vat_total', vat_total | money) }} {{ currency }}</td></tr>
      <tr class="grand"><th>Total due / المستحق</th><td>{{ s.field_ltr('total', total | money) }} {{ currency }}</td></tr>
    </table>
  </section>

  <footer>
    Payment by bank transfer only, to IBAN {{ s.field_ltr('iban', iban) }}.
    <span dir="rtl" lang="ar">السداد عن طريق التحويل المصرفي فقط.</span>
  </footer>
</div>
</body>
</html>
